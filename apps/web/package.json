    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.2",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.2",
    "vitest-browser-svelte": "^2.1.0"
  }
